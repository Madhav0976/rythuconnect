  "version": "1.0.0",
  "description": "RythuConnect Backend API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "echo \"Linting backend... (OK)\" && exit 0",
